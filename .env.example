# Non-secret runtime settings only. Secrets are files under ./secrets/<name> (dev)
# or Docker secrets at /run/secrets/<name> (prod), referenced by name from hosts.yaml.
ATLAS_CONFIG_DIR=./config
ATLAS_DATA_DIR=./data
ATLAS_LOG_LEVEL=INFO
# demo | live  (live also requires --live on the CLI)
ATLAS_TRANSPORT=demo
