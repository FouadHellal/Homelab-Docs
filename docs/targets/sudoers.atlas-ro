# /etc/sudoers.d/atlas-ro -- generated by `atlas targets render` (probe 1.0.0).
# Install root:root 0440 and validate with: visudo -cf /etc/sudoers.d/atlas-ro
# Exact argv only: no wildcards, so sudo refuses any other argument.
Defaults:atlas-ro !requiretty, !lecture, env_reset, secure_path="/usr/sbin:/usr/bin:/sbin:/bin"
Cmnd_Alias ATLAS_PROBE = /usr/local/libexec/atlas-probe cron, \
    /usr/local/libexec/atlas-probe docker, \
    /usr/local/libexec/atlas-probe net, \
    /usr/local/libexec/atlas-probe os, \
    /usr/local/libexec/atlas-probe packages, \
    /usr/local/libexec/atlas-probe pi, \
    /usr/local/libexec/atlas-probe ports, \
    /usr/local/libexec/atlas-probe services, \
    /usr/local/libexec/atlas-probe storage, \
    /usr/local/libexec/atlas-probe users, \
    /usr/local/libexec/atlas-probe version
atlas-ro ALL=(root) NOPASSWD: ATLAS_PROBE
