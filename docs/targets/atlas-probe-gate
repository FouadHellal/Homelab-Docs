#!/bin/bash
# atlas-probe-gate 1.1.0 -- forced command for the atlas-ro SSH key (ADR-002).
# Generated by `atlas targets render`; do not edit by hand.
#
# sshd runs this instead of whatever the client asked for. The request arrives in
# SSH_ORIGINAL_COMMAND and must match one fixed string exactly. No splitting, globbing,
# eval or arguments: anything else exits 64. On a match it runs the root-owned probe via
# sudo with exactly one constant argument, which sudoers also pins.
set -euo pipefail
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly SUDO="/usr/bin/sudo"
readonly PROBE="/usr/local/libexec/atlas-probe"
request="${SSH_ORIGINAL_COMMAND-}"

case "$request" in
    "atlas-probe cron")
        section=cron
        ;;
    "atlas-probe docker")
        section=docker
        ;;
    "atlas-probe net")
        section=net
        ;;
    "atlas-probe os")
        section=os
        ;;
    "atlas-probe packages")
        section=packages
        ;;
    "atlas-probe pi")
        section=pi
        ;;
    "atlas-probe ports")
        section=ports
        ;;
    "atlas-probe services")
        section=services
        ;;
    "atlas-probe storage")
        section=storage
        ;;
    "atlas-probe users")
        section=users
        ;;
    "atlas-probe version")
        section=version
        ;;
    *)
        # Never log the request itself (log injection); its length is enough to investigate.
        logger -t atlas-probe-gate -p auth.warning "refused request, length=${#request}" \
            2>/dev/null || true
        echo "atlas-probe-gate: refused" >&2
        exit 64
        ;;
esac

exec "$SUDO" -n -- "$PROBE" "$section"
